<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iPhones with ProMotion hold app rendering at 60 Hz unless the app asks; the stream is 120 fps
	     on those panels, so ask. iPads ignore this key. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Export compliance: Sill uses no encryption but Apple's own, so uploads, TestFlight builds
	     included, skip the encryption questions. Look again before adding cipher code or a crypto
	     library of Sill's own (docs/app-store-metadata.md section 6). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Finds your Mac on the local network.</string>
	<!-- The Debug configuration builds from Info-Debug.plist: this file plus the test service type
	     (docs/home-pairing-plan.md §7.9). A key added here goes there too. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_sill._tcp</string>
	</array>
	<!-- Picture in Picture (docs/picture-in-picture-plan.md): AVKit takes a picture into iOS's floating
	     window, and keeps the app running while it shows, only with the audio background mode (Xcode's
	     "Audio, AirPlay, and Picture in Picture"). Nothing else uses it: Sill's sound still stops in the
	     background unless that window plays it (PictureInPicturePolicy.soundHeard). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Add a Mac: the embedded scanner reads the pairing code the Mac shows. -->
	<!-- The floating mic in landscape: hold to talk, the phrase is typed on the Mac. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Sill listens while you hold the mic button and types what you say on your Mac.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Sill turns what you say into text to type on your Mac.</string>
	<key>NSCameraUsageDescription</key>
	<string>Sill scans the code on your Mac to pair with it.</string>
	<!-- sill://pair links from the Camera or Messages. Never acted on without a confirmation, since
	     another app could claim the scheme too; the in-app scanner is the main path. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>me.saffer.sill.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sill</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
